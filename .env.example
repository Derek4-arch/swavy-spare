# Swavy Spare settings. Copy this file to ".env" (same folder as start.bat) and change what you need.
# Lines starting with # are ignored. Restart the app after changing anything.

# Web address port: http://localhost:3001 (if it is busy, the next free port is used)
PORT=3001

# 127.0.0.1 keeps the app on this computer only.
# HOST=0.0.0.0 lets phones on the same Wi-Fi open it.
HOST=127.0.0.1

# Password for the admin page (#/admin). PLEASE CHANGE IT.
ADMIN_PASSWORD=swavyadmin

# Folder for the database and uploaded photos.
DATA_DIR=data

# Days a login lasts.
SESSION_DAYS=30

# SEED=1 fills a brand-new database with SAMPLE demo data. SEED=0 starts empty.
SEED=1
QUIET=0
